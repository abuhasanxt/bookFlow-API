model Resource {
  id                String   @id @default(uuid())
  name              String
  type              ResourceType
  description       String?
  capacity          Int
  priceCentsPerHour Int
  isActive          Boolean  @default(true)

  amenities Amenity[]
  hours ResourceHours[]
  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("resources")
}